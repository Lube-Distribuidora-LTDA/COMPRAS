{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/dados.js": {
      "maxDuration": 30
    },
    "api/agente.js": {
      "maxDuration": 30
    },
    "api/img.js": {
      "maxDuration": 15
    },
    "api/fotos.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://painel-lube-distribuidora.vercel.app"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
